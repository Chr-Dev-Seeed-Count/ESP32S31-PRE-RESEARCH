# Custom command for CMakeFiles\encrypted-app-flash

build CMakeFiles/encrypted-app-flash | ${cmake_ninja_workdir}CMakeFiles/encrypted-app-flash: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\touch\tp03_concurrent_load\build_check2 && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "Error: The target encrypted-app-flash requires" && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" D:/Espressif/tools/cmake/4.0.3/bin/cmake.exe -P D:/Espressif-master/.espressif/master/esp-idf/tools/cmake/scripts/fail.cmake"


