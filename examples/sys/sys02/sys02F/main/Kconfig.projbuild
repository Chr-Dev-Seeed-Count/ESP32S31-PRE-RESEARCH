menu "SYS-02F long stress"

config SYS02F_DURATION_MINUTES
    int "Stress duration (minutes)"
    range 1 1440
    default 10
    help
        Use 1440 for the formal 24-hour SYS-02F run. A shorter default keeps
        the first smoke test manageable.

config SYS02F_LOG_INTERVAL_SEC
    int "Log interval (seconds)"
    range 1 3600
    default 60

endmenu
