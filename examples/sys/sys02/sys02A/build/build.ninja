#############################################
# Utility command for edit_cache

build esp-idf/main/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\main && D:\Espressif\tools\cmake\4.0.3\bin\cmake-gui.exe -SD:\ESP32S31\examples\sys\sys02A -BD:\ESP32S31\examples\sys\sys02A\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/main/edit_cache: phony esp-idf/main/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/main/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\main && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe --regenerate-during-build -SD:\ESP32S31\examples\sys\sys02A -BD:\ESP32S31\examples\sys\sys02A\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/main/rebuild_cache: phony esp-idf/main/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build esp-idf/main/list_install_components: phony


#############################################
# Utility command for install

build esp-idf/main/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/main/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\main && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/main/install: phony esp-idf/main/CMakeFiles/install.util


#############################################
# Utility command for install/local

build esp-idf/main/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/main/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\main && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build esp-idf/main/install/local: phony esp-idf/main/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build esp-idf/main/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/main/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\main && D:\Espressif\tools\cmake\4.0.3\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/main/install/strip: phony esp-idf/main/CMakeFiles/install/strip.util

