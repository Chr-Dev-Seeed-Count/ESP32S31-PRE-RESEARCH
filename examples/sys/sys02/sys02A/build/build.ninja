# Utility command for edit_cache

build esp-idf/wpa_supplicant/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\ESP32S31\examples\sys\sys02A\build\esp-idf\wpa_supplicant && D:\Espressif\tools\cmake\4.0.3\bin\cmake-gui.exe -SD:\ESP32S31\examples\sys\sys02A -BD:\ESP32S31\examples\sys\sys02A\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/wpa_supplicant/edit_cache: phony esp-idf/wpa_supplicant/CMakeFiles/edit_cache.util


#############################################
